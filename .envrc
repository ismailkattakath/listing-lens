# direnv entry point: `direnv allow` once. Holds NO values.
use flake
dotenv_if_exists .env
dotenv_if_exists .env.local
# Per-operator overrides (gitignored, a SHELL file so it can compute rather than store), e.g.
#   export LLENS_DATA="<your Google Drive folder>"            # data: synced
#   export LLENS_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/listing-insights"  # state: local only
#   export LLENS_MCP_LAUNCHER="<command that starts a chrome-devtools MCP server>"
#   export LLENS_FORBIDDEN_LITERALS="<file of literals that must never land in this repo>"
source_env_if_exists .envrc.local
